{
    "schemaVersion":  1,
    "id":  "veil",
    "version":  "4.2.1",
    "name":  "Veil",
    "description":  "Veil is a sophisticated collection of tools and utilities designed to facilitate advanced rendering for Minecraft mod developers. Our goal is to enable more modern game-engine level content in Java Minecraft, pushing the boundaries of what is possible in modding.",
    "icon":  "icon.png",
    "authors":  [
                    "amo",
                    "Cappin",
                    "Ocelot"
                ],
    "contributors":  [
                         "Farcr (Artist)"
                     ],
    "contact":  {
                    "homepage":  "https://modrinth.com/project/veil",
                    "issues":  "https://github.com/FoundryMC/Veil/issues",
                    "sources":  "https://github.com/FoundryMC/Veil"
                },
    "license":  "LGPLv3",
    "environment":  "*",
    "entrypoints":  {
                        "main":  [
                                     "foundry.veil.fabric.VeilFabric"
                                 ],
                        "client":  [
                                       "foundry.veil.fabric.VeilFabricClient"
                                   ]
                    },
    "custom":  {
                   "fabric-renderer-indigo:force_compatibility":  true,
                   "modmenu":  {
                                   "links":  {
                                                 "modmenu.discord":  "https://discord.com/invite/2aqTX9QWKU",
                                                 "modmenu.modrinth":  "https://modrinth.com/mod/veil",
                                                 "modmenu.wiki":  "https://github.com/FoundryMC/Veil/wiki"
                                             }
                               }
               },
    "mixins":  [
