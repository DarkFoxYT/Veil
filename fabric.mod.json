                   "veil.debug.mixins.json",
                   "veil.dynamicbuffer.mixins.json",
                   "veil.fix.mixins.json",
                   "veil.framebuffer.mixins.json",
                   "veil.network.mixins.json",
                   "veil.necromancer.mixins.json",
                   "veil.performance.mixins.json",
                   "veil.perspective.mixins.json",
                   "veil.pipeline.mixins.json",
                   "veil.quasar.mixins.json",
                   "veil.registry.mixins.json",
                   "veil.rendertype.mixins.json",
                   "veil.resource.mixins.json",
                   "veil.shader.mixins.json",
                   "veil.scheduler.mixins.json",
                   "veil.fabric.mixins.json"
               ],
    "depends":  {
                    "fabricloader":  "\u003e=0.19.3",
